{
  "name": "arcbridge",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint packages/",
    "typecheck": "tsc --noEmit -p packages/core/tsconfig.json && tsc --noEmit -p packages/adapters/tsconfig.json && tsc --noEmit -p packages/mcp-server/tsconfig.json && tsc --noEmit -p packages/cli/tsconfig.json && tsc --noEmit -p packages/bench/tsconfig.json",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "clean": "pnpm -r clean",
    "bump": "node scripts/bump-version.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "eslint": "^10.2.0",
    "tsup": "^8.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.58.0",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "flatted": ">=3.4.2",
      "picomatch@<2.3.2": "2.3.2",
      "picomatch@4.0.3": "4.0.4",
      "hono": "4.13.7",
      "@hono/node-server": "1.19.15",
      "vite": ">=7.3.2",
      "postcss": "8.5.23",
      "fast-uri@>=3.0.0 <3.1.8": "3.1.8",
      "proxy-addr@>=2.0.0 <2.0.8": "2.0.8",
      "brace-expansion@>=5.0.0 <5.0.12": "5.0.12",
      "ip-address@<=10.7.0": "10.7.1",
      "qs@>=6.0.0 <6.16.0": "6.16.0",
      "js-yaml@>=3.0.0 <3.15.2": "3.15.2",
      "nanoid@>=3.0.0 <3.3.18": "3.3.18",
      "@humanfs/node@<0.16.8": "0.16.8",
      "source-map-js@<1.2.2": "1.2.2",
      "body-parser@>=2.0.0 <2.3.0": "2.3.0",
      "esbuild@>=0.27.3 <0.28.1": "0.28.1"
    }
  },
  "engines": {
    "node": ">=22.16.0",
    "pnpm": ">=9.0.0"
  }
}
